{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/gev?__gevpath=:path*" }
  ],
  "functions": {
    "api/gev.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{server,src,config,build}/**"
    }
  }
}
