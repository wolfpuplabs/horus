{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "horus-eight-rho.vercel.app"
        }
      ],
      "destination": "https://horus-of-wolfpuplab.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/gev?__gevpath=:path*"
    }
  ],
  "functions": {
    "api/gev.js": {
      "maxDuration": 300,
      "includeFiles": "{server,src,config,build}/**"
    }
  }
}
